# PAIS Milestone 1 local development configuration

APP_NAME=PAIS
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Host-side application connection.
DATABASE_URL=postgresql+asyncpg://pais:pais@localhost:5432/pais

# Docker Compose PostgreSQL settings.
POSTGRES_DB=pais
POSTGRES_USER=pais
POSTGRES_PASSWORD=pais
POSTGRES_PORT=5432

# Docker Compose API settings.
API_PORT=8000

# Embedding Details
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true
