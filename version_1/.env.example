# PAIS Milestone 1 local development configuration

APP_NAME=PAIS
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Host-side application connection.
DATABASE_URL=postgresql+asyncpg://pais:pais@localhost:5432/pais

# Docker Compose PostgreSQL settings.
POSTGRES_DB=pais
POSTGRES_USER=pais
POSTGRES_PASSWORD=pais
POSTGRES_PORT=5432

# Docker Compose API settings.
API_PORT=8000

# Embedding Details
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true

# Reranker Details
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=16

# LLM Details
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60.0