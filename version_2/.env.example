# PAIS local development configuration

APP_NAME=PAIS
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Host-side application connection.
DATABASE_URL=postgresql+asyncpg://pais_v2:pais_v2@localhost:5433/pais_v2

# Docker Compose PostgreSQL settings.
# Use strong, externally managed credentials for staging/production.
POSTGRES_DB=pais_v2
POSTGRES_USER=pais_v2
POSTGRES_PASSWORD=pais_v2
POSTGRES_PORT=5433

# Docker Compose API settings.
API_PORT=8001

# Embedding Details
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true

# Reranker Details
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=16

# LLM Details
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=120.0

# Authentication
# Required when using authenticated API endpoints.
# Generate a strong random value for local/staging/production use.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=

# Request / upload limits
MAX_UPLOAD_SIZE_BYTES=10485760